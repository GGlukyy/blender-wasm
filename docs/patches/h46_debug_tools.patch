+#ifdef __EMSCRIPTEN__
+/* DEBUG (H46): print stencil histogram + 64x32 grid from the capture buffer on the render thread
+ * (the buffer handle only exists in this thread's JS context, so JS on the main thread cannot map it). */
+static void webgpu_stencil_print_cb(WGPUMapAsyncStatus status, WGPUStringView, void *, void *)
+{
+  if (status != WGPUMapAsyncStatus_Success || g_capture_buf == nullptr) {
+    fprintf(stderr, "STENCIL_GRID map failed %d\n", int(status));
+    fflush(stderr);
+    return;
+  }
+  const uint32_t w = g_capture_w, h = g_capture_h, bpr = g_capture_bpr;
+  const uint8_t *p = static_cast<const uint8_t *>(
+      wgpuBufferGetConstMappedRange(g_capture_buf, 0, size_t(bpr) * h));
+  if (p == nullptr) {
+    fprintf(stderr, "STENCIL_GRID no range\n");
+    fflush(stderr);
+    return;
+  }
+  uint32_t hist[256] = {};
+  for (uint32_t y = 0; y < h; y += 2) {
+    for (uint32_t x = 0; x < w; x += 2) {
+      hist[p[size_t(y) * bpr + x]]++;
+    }
+  }
+  fprintf(stderr, "STENCIL_GRID %ux%u hist:", w, h);
+  for (int v = 0; v < 256; v++) {
+    if (hist[v]) {
+      fprintf(stderr, " %d=%u", v, hist[v]);
+    }
+  }
+  fprintf(stderr, "\n");
+  for (int gy = 0; gy < 32; gy++) {
+    char row[65];
+    for (int gx = 0; gx < 64; gx++) {
+      const uint8_t v = p[size_t((gy * 2 + 1) * h / 64) * bpr + size_t((gx * 2 + 1) * w / 128)];
+      row[gx] = v == 0 ? '.' : (v < 10 ? char('0' + v) : '#');
+    }
+    row[64] = 0;
+    fprintf(stderr, "STENCIL_ROW %s\n", row);
+  }
+  fflush(stderr);
+  wgpuBufferUnmap(g_capture_buf);
+}
+#endif
+
+#ifdef __EMSCRIPTEN__
+struct DbgPrint {
+  WGPUBuffer buf;
+  size_t n;
+  char label[96];
+};
+static void webgpu_dbg_print_cb(WGPUMapAsyncStatus status, WGPUStringView, void *u1, void *)
+{
+  DbgPrint *d = static_cast<DbgPrint *>(u1);
+  if (status != WGPUMapAsyncStatus_Success) {
+    fprintf(stderr, "DBGBUF %s map failed %d\n", d->label, int(status));
+    fflush(stderr);
+    return;
+  }
+  const uint32_t *u = static_cast<const uint32_t *>(wgpuBufferGetConstMappedRange(d->buf, 0, d->n));
+  const float *f = reinterpret_cast<const float *>(u);
+  fprintf(stderr, "DBGBUF %s u32:", d->label);
+  for (size_t i = 0; i < d->n / 4; i++) {
+    fprintf(stderr, " %u", u[i]);
+  }
+  fprintf(stderr, "\nDBGBUF %s f32:", d->label);
+  for (size_t i = 0; i < d->n / 4; i++) {
+    fprintf(stderr, " %g", f[i]);
+  }
+  fprintf(stderr, "\n");
+  fflush(stderr);
+  wgpuBufferUnmap(d->buf);
+}
+#endif
+
+/* DEBUG (H46): copy `n` bytes at `offset` of `src` into a staging buffer and print them (u32 + f32) from the render thread. */
+void WebGPUContext::debug_print_buffer(WGPUBuffer src, uint64_t offset, size_t n, const char *label)
+{
+#ifdef __EMSCRIPTEN__
+  if (src == nullptr || device_ == nullptr) {
+    return;
+  }
+  n = (n + 3) & ~size_t(3);
+  WGPUBufferDescriptor bd = {};
+  bd.size = (n + 3) & ~size_t(3);
+  bd.usage = WGPUBufferUsage_CopyDst | WGPUBufferUsage_MapRead;
+  WGPUBuffer st = wgpuDeviceCreateBuffer(device_, &bd);
+  render_pass_end();
+  WGPUCommandEncoder enc = ensure_encoder();
+  if (enc == nullptr || st == nullptr) {
+    return;
+  }
+  wgpuCommandEncoderCopyBufferToBuffer(enc, src, offset, st, 0, n);
+  flush_encoder();
+  DbgPrint *d = new DbgPrint();
+  d->buf = st;
+  d->n = n;
+  snprintf(d->label, sizeof(d->label), "%s", label);
+  WGPUBufferMapCallbackInfo ci = {};
+  ci.mode = WGPUCallbackMode_AllowSpontaneous;
+  ci.callback = webgpu_dbg_print_cb;
+  ci.userdata1 = d;
+  wgpuBufferMapAsync(st, WGPUMapMode_Read, 0, n, ci);
+#endif
+}
