# H46: Workbench Solid + Shadows 1.0 — kostka + plane. Web musí odpovídat desktopu 5.3.0: kostka NEztmavená, vržený stín jen vedle kostky.
import bpy, sys, time
def out(*a):
    print(*a); sys.stdout.flush()
bpy.ops.object.select_all(action='SELECT'); bpy.ops.object.delete()
bpy.ops.mesh.primitive_cube_add(location=(0, 0, 0.0))
bpy.ops.mesh.primitive_plane_add(size=6, location=(0, 0, -1))
bpy.ops.object.select_all(action='DESELECT')
for a in bpy.context.window_manager.windows[0].screen.areas:
    if a.type == 'VIEW_3D':
        sh = a.spaces.active.shading; sh.type = 'SOLID'; sh.show_shadows = True; sh.shadow_intensity = 1.0
st = {'t0': time.time()}
def tick():
    if time.time() - st['t0'] < 10: return 1.0
    out('OPS volume shown'); out('OPS_DONE')
    return None
bpy.app.timers.register(tick, first_interval=2.0)
